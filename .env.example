# --- LLM provider ---
# Anthropic (forced tool-use) is the default and best-supported backend.
# An OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio, OpenRouter,
# Groq, Together, ...) is also supported via LLM_BASE_URL + LLM_MODEL.
# With none of the LLM_* vars set, behaviour is identical to before.
LLM_PROVIDER=anthropic                 # anthropic | openai-compatible
LLM_MODEL=                             # empty = provider default
LLM_BASE_URL=                          # e.g. http://localhost:11434/v1 for Ollama
LLM_SCHEMA_MODE=auto                   # schema | json-object | auto
LLM_TEMPERATURE=0                      # 0 = most reliable structured output
LLM_MAX_RETRIES=1                      # corrective retries before degrading to raw
LLM_AUDIT_MODE=off                     # off (default) | hash (identity+SHA256) | full (incl. bodies)
# API key from a mounted file (preferred). Falls back to ANTHROPIC_API_KEY below.
LLM_API_KEY_FILE=

# Back-compat: still read when LLM_API_KEY_FILE is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# --- Provider examples ---
# (a) Default Anthropic: set ANTHROPIC_API_KEY (or LLM_API_KEY_FILE) only.
# (b) Ollama, no key:
#   LLM_PROVIDER=openai-compatible
#   LLM_MODEL=qwen2.5
#   LLM_BASE_URL=http://localhost:11434/v1
# (c) OpenAI, file-mounted key:
#   LLM_PROVIDER=openai-compatible
#   LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_SCHEMA_MODE=schema
#   LLM_API_KEY_FILE=/secrets/llm/api-key

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
GENERIC_WEBHOOK_URL=
ALERTMANAGER_URL=http://alertmanager.monitoring.svc:9093
ALERTMANAGER_SILENCE_ENABLED=false
ALERTMANAGER_SILENCE_DURATION=2h
DEDUP_WINDOW_MINUTES=15
GRAFANA_BASE_URL=https://grafana.yourdomain.com
PORT=8080
LOG_LEVEL=info
